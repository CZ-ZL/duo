    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "^0.1.2-rc.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./index.js",
    "./legacy": "./legacy.js",
    "./package.json": "./package.json",
    "./definitions": {
      "types": "./native/definitions.d.ts",
