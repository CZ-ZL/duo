    "./model-accounting": "./native/model-call.js",
    "./docs-evaluators": "./native/docs-evaluators.js",
    "./semantic-evaluators": "./native/semantic-evaluators.js",
    "./json-output": "./native/json-output.js",
    "./evaluation-controller": "./native/evaluation-controller.js",
