    "./contract": "./native/contract.js",
    "./provider-contract": "./native/provider-contract.js",
    "./stages": "./native/stages.js",
    "./onboarding": "./native/onboarding.js",
    "./observer": "./native/observer.js",
    "./observer-tools": "./native/observer-tools.js",
    "./history-feedback": "./native/history-feedback.js",
    "./exclusion-comparator": "./native/exclusion-comparator.js",
