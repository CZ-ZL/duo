    "native/bounded-tie-gate.js",
    "native/journal.js",
    "native/model-call.js",
    "native/model-executor.js",
    "native/model-generator.js",
    "native/docs-evaluators.js",
    "native/semantic-evaluators.js",
    "native/policies.js",
    "native/store.js",
    "native/target.js",
    "native/tools.js",
    "native/money.js",
    "native/json-output.js",
    "native/deferred-runtime.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "dualloop"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
