{
  "version": 1,
  "id": "explicit-noise-repeat-control",
  "target": {"kind": "dsh-persona", "path": "persona.txt"},
  "allowNoiseRepeats": true,
  "fast": {"evaluatorId": "fixture-fast", "version": "1", "dataId": "fast", "metric": "quality", "direction": "maximize", "weights": {"quality": 1}},
  "slow": {"evaluatorId": "fixture-slow", "version": "1", "dataId": "slow", "metric": "quality", "direction": "maximize", "weights": {"quality": 1}},
