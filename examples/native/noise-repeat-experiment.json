  "constraints": [{"metric": "safe", "op": "==", "value": true}],
  "epsilon": 0.01,
  "minSamples": 2,
  "generations": 1,
  "quotas": {"exploit": 1, "explore": 0, "innovate": 0},
  "topK": 1,
  "permissions": {"paid": false, "network": false, "externalSideEffects": false},
  "budget": {"currency": "CNY", "maxCostCny": 0, "maxSessions": 9, "maxFastEvals": 2, "maxSlowEvals": 2, "maxWallTimeMs": 10000}
